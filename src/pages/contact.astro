---
import Layout from "../layouts/Layout.astro";

const disclaimer =
  "FlorishMed China provides non-clinical hospital navigation and healthcare access information only. We do not provide medical diagnosis, treatment, emergency care, medical guarantees, or official hospital representation unless explicitly authorized. Information on this website is for general guidance and should not replace professional medical advice from licensed healthcare providers.";
---

<Layout>
  <main>
    <section class="bg-[#0B1F3A] px-5 py-20 text-white">
      <div class="mx-auto max-w-7xl">
        <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#D96B4F]">Contact</p>
        <h1 class="mt-4 max-w-4xl text-4xl font-extrabold md:text-6xl">Request Hospital Navigation Guidance</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-white/75">
          Tell us what city in China you plan to visit, your timeline, and what practical access questions you have.
          Please do not submit emergency requests or highly sensitive medical documents through this form.
        </p>
      </div>
    </section>

    <section class="bg-[#F3F5F7] px-5 py-20">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <aside class="rounded-lg border border-[#35506B]/15 bg-white p-7 shadow-sm">
          <h2 class="text-2xl font-extrabold text-[#0B1F3A]">Before You Submit</h2>
          <p class="mt-4 leading-7 text-[#6B7280]">
            Please do not submit emergency requests or highly sensitive medical documents through this form. If you are
            experiencing a medical emergency in China, please contact local emergency services or go to the nearest
            hospital immediately.
          </p>
          <p class="mt-6 font-bold text-[#0B1F3A]">Email: hello@florishmedchina.com</p>
        </aside>

        <form class="rounded-lg border border-[#35506B]/15 bg-white p-7 shadow-sm" action="mailto:hello@florishmedchina.com" method="post" enctype="text/plain">
          <div class="grid gap-5 md:grid-cols-2">
            <label class="flex flex-col gap-2 font-bold text-[#0B1F3A]">Name<input required name="name" class="rounded-lg border border-[#35506B]/20 px-4 py-3 font-normal text-[#1F2933] focus:border-[#D96B4F] focus:outline-none" /></label>
            <label class="flex flex-col gap-2 font-bold text-[#0B1F3A]">Email<input required type="email" name="email" class="rounded-lg border border-[#35506B]/20 px-4 py-3 font-normal text-[#1F2933] focus:border-[#D96B4F] focus:outline-none" /></label>
            <label class="flex flex-col gap-2 font-bold text-[#0B1F3A]">Current country / region<input name="current-country-region" class="rounded-lg border border-[#35506B]/20 px-4 py-3 font-normal text-[#1F2933] focus:border-[#D96B4F] focus:outline-none" /></label>
            <label class="flex flex-col gap-2 font-bold text-[#0B1F3A]">City in China you plan to visit<input name="china-city" class="rounded-lg border border-[#35506B]/20 px-4 py-3 font-normal text-[#1F2933] focus:border-[#D96B4F] focus:outline-none" /></label>
            <label class="flex flex-col gap-2 font-bold text-[#0B1F3A]">Type of medical need<input name="medical-need-type" class="rounded-lg border border-[#35506B]/20 px-4 py-3 font-normal text-[#1F2933] focus:border-[#D96B4F] focus:outline-none" /></label>
            <label class="flex flex-col gap-2 font-bold text-[#0B1F3A]">Preferred hospital type, if known<select name="preferred-hospital-type" class="rounded-lg border border-[#35506B]/20 px-4 py-3 font-normal text-[#1F2933] focus:border-[#D96B4F] focus:outline-none"><option value="">Not sure yet</option><option>Public hospital</option><option>Private hospital / clinic</option><option>International department</option></select></label>
            <label class="flex flex-col gap-2 font-bold text-[#0B1F3A] md:col-span-2">Timeline<input name="timeline" class="rounded-lg border border-[#35506B]/20 px-4 py-3 font-normal text-[#1F2933] focus:border-[#D96B4F] focus:outline-none" /></label>
            <label class="flex flex-col gap-2 font-bold text-[#0B1F3A] md:col-span-2">What help do you need?<textarea required name="help-needed" rows="6" class="resize-y rounded-lg border border-[#35506B]/20 px-4 py-3 font-normal text-[#1F2933] focus:border-[#D96B4F] focus:outline-none"></textarea></label>
          </div>
          <button type="submit" class="mt-6 rounded-full bg-[#D96B4F] px-8 py-3.5 font-bold text-white transition hover:bg-[#B8513C]">Request Guidance</button>
        </form>
      </div>
    </section>

    <section class="bg-[#F3F5F7] px-5 pb-16">
      <div class="mx-auto max-w-7xl rounded-lg border border-[#35506B]/15 bg-white p-6">
        <h2 class="text-xl font-extrabold text-[#0B1F3A]">Disclaimer</h2>
        <p class="mt-3 leading-7 text-[#6B7280]">{disclaimer}</p>
      </div>
    </section>
  </main>
</Layout>
