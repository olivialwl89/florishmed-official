---
import Layout from "../layouts/Layout.astro";
import { blogPosts } from "../data/blogData.js";
---

<Layout>
  <main>
    <section class="bg-[#0B1F3A] px-5 py-20 text-white">
      <div class="mx-auto max-w-7xl">
        <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#D96B4F]">FlorishMed China</p>
        <h1 class="mt-4 max-w-4xl text-4xl font-extrabold md:text-6xl">China Healthcare Guide</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-white/75">
          Placeholder guide topics for international visitors, expats, and global patients preparing to understand
          hospital access in China. These articles avoid unsupported statistics and medical claims.
        </p>
      </div>
    </section>

    <section class="bg-[#F3F5F7] px-5 py-20">
      <div class="mx-auto grid max-w-7xl gap-6 md:grid-cols-2 lg:grid-cols-3">
        {blogPosts.map((post) => (
          <article class="flex min-h-64 flex-col rounded-lg border border-[#35506B]/15 bg-white p-6 shadow-sm">
            <p class="text-sm font-bold uppercase tracking-[0.16em] text-[#D96B4F]">Guide</p>
            <h2 class="mt-4 text-2xl font-extrabold leading-8 text-[#0B1F3A]">{post.title}</h2>
            <p class="mt-4 flex-1 leading-7 text-[#6B7280]">{post.description}</p>
            <a href="/contact" class="mt-6 font-extrabold text-[#D96B4F]">Ask about this topic</a>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
