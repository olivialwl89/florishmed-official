---
const links = [
  { href: "/", label: "Home" },
  { href: "/#services", label: "Services" },
  { href: "/blog", label: "China Healthcare Guide" },
  { href: "/#faq", label: "Patient FAQ" },
  { href: "/#about", label: "About" },
];
---

<nav class="sticky top-0 z-50 border-b border-[#35506B]/20 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4">
    <a href="/" class="flex flex-col leading-tight">
      <span class="text-lg font-extrabold tracking-wide text-[#0B1F3A]">FlorishMed China</span>
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-[#D96B4F]">Hospital Navigation</span>
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      {links.map((link) => (
        <a href={link.href} class="text-sm font-bold text-[#1F2933] transition hover:text-[#D96B4F]">
          {link.label}
        </a>
      ))}
      <a href="/contact" class="rounded-full bg-[#D96B4F] px-5 py-2.5 text-sm font-bold text-white transition hover:bg-[#B8513C]">
        Request Guidance
      </a>
    </div>

    <details class="relative lg:hidden">
      <summary class="flex cursor-pointer list-none items-center rounded-full border border-[#35506B]/30 px-4 py-2 text-sm font-bold text-[#0B1F3A]">
        Menu
      </summary>
      <div class="absolute right-0 mt-3 flex w-72 flex-col gap-4 rounded-lg border border-[#35506B]/20 bg-white p-5 shadow-xl">
        {links.map((link) => (
          <a href={link.href} class="font-bold text-[#1F2933] hover:text-[#D96B4F]">{link.label}</a>
        ))}
        <a href="/contact" class="rounded-full bg-[#D96B4F] px-5 py-3 text-center font-bold text-white">
          Request Guidance
        </a>
      </div>
    </details>
  </div>
</nav>
