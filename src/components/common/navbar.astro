---
const links = [
  { href: "/", label: "Home" },
  { href: "/#services", label: "Services" },
  { href: "/blog", label: "China Healthcare Guide" },
  { href: "/#faq", label: "Patient FAQ" },
  { href: "/#about", label: "About" },
];
---

<nav class="sticky top-0 z-50 border-b border-[#35506B]/20 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3">
    <a href="/" class="flex items-center" aria-label="FlorishMed China home">
      <img
        src="/florishmed logo.png"
        alt="FlorishMed China"
        class="h-10 w-auto max-w-[210px] object-contain sm:h-11 sm:max-w-[240px] md:h-12 md:max-w-[260px]"
      />
    </a>
    <div class="hidden items-center gap-7 text-sm font-semibold text-[#35506B] md:flex">
      {links.map((link) => <a class="transition hover:text-[#D96B4F]" href={link.href}>{link.label}</a>)}
    </div>
    <a class="hidden rounded-full bg-[#D96B4F] px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-[#0B1F3A]/10 transition hover:bg-[#C85F45] md:inline-flex" href="/contact">
      Request Guidance
    </a>
  </div>
</nav>
