---
const year = new Date().getFullYear();
const disclaimer =
  "FlorishMed China provides non-clinical hospital navigation and healthcare access information only. We do not provide medical diagnosis, treatment, emergency care, medical guarantees, or official hospital representation unless explicitly authorized. Information on this website is for general guidance and should not replace professional medical advice from licensed healthcare providers.";
---

<footer class="bg-[#0B1F3A] text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-12 md:grid-cols-[1.1fr_0.8fr_1.3fr]">
    <div>
      <p class="text-2xl font-extrabold">FlorishMed China</p>
      <p class="mt-3 max-w-sm text-sm leading-6 text-white/78">
        Independent non-clinical hospital navigation guidance.
      </p>
      <p class="mt-5 text-sm font-semibold text-[#F3F5F7]">Email: hello@florishmedchina.com</p>
    </div>

    <nav class="flex flex-col gap-3 text-sm font-bold text-white/85">
      <a href="/" class="hover:text-[#D96B4F]">Home</a>
      <a href="/#services" class="hover:text-[#D96B4F]">Services</a>
      <a href="/blog" class="hover:text-[#D96B4F]">China Healthcare Guide</a>
      <a href="/#faq" class="hover:text-[#D96B4F]">FAQ</a>
      <a href="/contact" class="hover:text-[#D96B4F]">Contact</a>
    </nav>

    <p class="text-sm leading-6 text-white/72">{disclaimer}</p>
  </div>
  <div class="border-t border-[#35506B] px-5 py-5 text-center text-sm text-white/68">
    &copy; {year} FlorishMed China. All rights reserved.
  </div>
</footer>
